{
  "//": "Only used by TypeDoc (npm run docs): one program that sees the shared package and the server together.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["packages/shared/src", "server/src"],
  "exclude": ["**/*.test.ts"]
}
