// Data model v1 (first slice: people & places). See project_spec.md §5.
// Rules Prisma can't express (case-insensitive unit uniqueness, no-overlap occupancy,
// one billing contact, CHECKs) are added as raw SQL in the migration files.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RESIDENT
  STAFF
  ADMIN
}

enum Language {
  EN
  BN
}

enum TextSize {
  NORMAL
  LARGE
}

enum OccupancyType {
  OWNER
  TENANT
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  loginId            String    @unique
  passwordHash       String
  role               Role
  fullName           String
  phone              String
  language           Language  @default(EN)
  textSize           TextSize  @default(NORMAL)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz
  createdAt          DateTime  @default(now()) @db.Timestamptz
  updatedAt          DateTime  @updatedAt @db.Timestamptz

  profile          ResidentProfile?
  permissions      StaffPermission[]
  occupancies      Occupancy[]
  householdOf      HouseholdMember[]
  billsAsContact   Bill[]            @relation("BillingContact")
  billsCreated     Bill[]            @relation("BillCreator")
  paymentsRecorded Payment[]         @relation("PaymentRecorder")
  paymentsVoided   Payment[]         @relation("PaymentVoider")

  requestsSubmitted   MaintenanceRequest[] @relation("RequestSubmitter")
  requestsAssigned    MaintenanceRequest[] @relation("RequestAssignee")
  requestUpdates      RequestUpdate[]      @relation("UpdateAuthor")
  attachmentsUploaded Attachment[]         @relation("AttachmentUploader")

  @@map("users")
}

model ResidentProfile {
  userId                String  @id @db.Uuid
  altPhone              String?
  emergencyContactName  String?
  emergencyContactPhone String?
  user                  User    @relation(fields: [userId], references: [id])

  @@map("resident_profiles")
}

model StaffPermission {
  userId     String @db.Uuid
  permission String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@map("staff_permissions")
}

model Unit {
  id          String  @id @default(uuid()) @db.Uuid
  unitNumber  String
  floor       Int
  sizeSqft    Int?
  bedrooms    Int?
  isAvailable Boolean @default(true)

  occupancies Occupancy[]
  bills       Bill[]
  fees        UnitFee[]
  requests    MaintenanceRequest[]

  @@map("units")
}

model Occupancy {
  id               String        @id @default(uuid()) @db.Uuid
  unitId           String        @db.Uuid
  residentId       String        @db.Uuid
  type             OccupancyType
  startDate        DateTime      @db.Date
  endDate          DateTime?     @db.Date
  isBillingContact Boolean       @default(false)

  unit      Unit              @relation(fields: [unitId], references: [id])
  resident  User              @relation(fields: [residentId], references: [id])
  household HouseholdMember[]

  @@index([unitId])
  @@index([residentId])
  @@map("occupancies")
}

model HouseholdMember {
  id          String    @id @default(uuid()) @db.Uuid
  occupancyId String    @db.Uuid
  userId      String    @db.Uuid
  relation    String
  addedAt     DateTime  @db.Date
  removedAt   DateTime? @db.Date

  occupancy Occupancy @relation(fields: [occupancyId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@map("household_members")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

// Managed by connect-pg-simple (express sessions). userId lets us end a user's
// other sessions after a password change (FR-31).
model Session {
  sid    String   @id
  sess   Json
  expire DateTime @db.Timestamp(6)
  userId String?  @db.Uuid

  @@index([expire])
  @@index([userId])
  @@map("session")
}

// ---------------------------------------------------------------- billing (Sprint 2)
// Money is integer poisha (1 BDT = 100 poisha). A bill's total / paid / balance / status are never stored:
// they are computed by the bill_summary view so they can never drift out of sync (SRS BR-09).

enum BillKind {
  REGULAR
  OPENING_BALANCE
}

enum ChargeType {
  SERVICE
  RENT
  WATER
  GAS
  ELECTRICITY
  OPENING_BALANCE
  OTHER
}

enum PaymentMethod {
  CASH
  BANK
  BKASH
  NAGAD
  ROCKET
  OTHER
}

/// Recurring charges applied when bills are generated. unitId null = the building-wide default.
model UnitFee {
  id          String     @id @default(uuid()) @db.Uuid
  unitId      String?    @db.Uuid
  chargeType  ChargeType
  amount      Int
  description String

  unit Unit? @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@map("unit_fees")
}

model Bill {
  id               String   @id @default(uuid()) @db.Uuid
  unitId           String   @db.Uuid
  kind             BillKind @default(REGULAR)
  billingMonth     DateTime @db.Date
  dueDate          DateTime @db.Date
  billingContactId String?  @db.Uuid
  note             String?
  createdById      String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz

  unit           Unit      @relation(fields: [unitId], references: [id])
  billingContact User?     @relation("BillingContact", fields: [billingContactId], references: [id])
  createdBy      User      @relation("BillCreator", fields: [createdById], references: [id])
  charges        Charge[]
  payments       Payment[]

  @@unique([unitId, billingMonth])
  @@index([billingMonth])
  @@map("bills")
}

model Charge {
  id          String     @id @default(uuid()) @db.Uuid
  billId      String     @db.Uuid
  type        ChargeType
  amount      Int
  description String

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("charges")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  billId       String        @db.Uuid
  amount       Int
  paidOn       DateTime      @db.Date
  method       PaymentMethod
  reference    String?
  receiptNo    String        @unique
  recordedById String        @db.Uuid
  voidedAt     DateTime?     @db.Timestamptz
  voidedById   String?       @db.Uuid
  voidReason   String?
  createdAt    DateTime      @default(now()) @db.Timestamptz

  bill       Bill  @relation(fields: [billId], references: [id])
  recordedBy User  @relation("PaymentRecorder", fields: [recordedById], references: [id])
  voidedBy   User? @relation("PaymentVoider", fields: [voidedById], references: [id])

  @@index([billId])
  @@index([method, reference])
  @@map("payments")
}

/// Yearly counters for receipt numbers (RCPT-YYYY-NNNNN) and certificates later. Incremented under a row lock.
model Counter {
  kind  String
  year  Int
  value Int

  @@id([kind, year])
  @@map("counters")
}

// -------------------------------------------------------------- maintenance (Sprint 3)

enum RequestCategory {
  PLUMBING
  ELECTRICAL
  LIFT
  GENERATOR
  WATER_SUPPLY
  GAS
  CLEANING
  SECURITY
  COMMON_AREA
  OTHER
}

enum RequestLocation {
  UNIT
  COMMON_AREA
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
  CANCELLED
}

enum UpdateKind {
  NOTE
  STATUS_CHANGE
  PRIORITY_CHANGE
  ASSIGNMENT
}

model MaintenanceRequest {
  id            String           @id @default(uuid()) @db.Uuid
  /// The human-friendly request number shown as #1024.
  number        Int              @unique @default(autoincrement())
  submittedById String           @db.Uuid
  unitId        String           @db.Uuid
  location      RequestLocation
  category      RequestCategory
  title         String
  description   String
  priority      RequestPriority?
  status        RequestStatus    @default(SUBMITTED)
  assignedToId  String?          @db.Uuid
  /// When it should be resolved by (BR-17): from the priority, or the review deadline while unprioritised.
  dueAt         DateTime         @db.Timestamptz
  resolvedAt    DateTime?        @db.Timestamptz
  closedAt      DateTime?        @db.Timestamptz
  createdAt     DateTime         @default(now()) @db.Timestamptz
  updatedAt     DateTime         @updatedAt @db.Timestamptz

  submittedBy User            @relation("RequestSubmitter", fields: [submittedById], references: [id])
  assignedTo  User?           @relation("RequestAssignee", fields: [assignedToId], references: [id])
  unit        Unit            @relation(fields: [unitId], references: [id])
  updates     RequestUpdate[]
  attachments Attachment[]

  @@index([status])
  @@index([submittedById])
  @@index([assignedToId])
  @@index([unitId])
  @@map("maintenance_requests")
}

/// The history of a request. Rows are only ever added: each records who did what and when (FR-20).
model RequestUpdate {
  id         String     @id @default(uuid()) @db.Uuid
  /// Order of insertion. Rows written in one transaction share a timestamp, so this is what keeps the history in order.
  seq        Int        @unique @default(autoincrement())
  requestId  String     @db.Uuid
  /// null means the system itself (for example the automatic close).
  authorId   String?    @db.Uuid
  kind       UpdateKind
  fromValue  String?
  toValue    String?
  note       String?
  /// Internal notes are visible to staff only, never to the resident.
  isInternal Boolean    @default(false)
  createdAt  DateTime   @default(now()) @db.Timestamptz

  request     MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author      User?              @relation("UpdateAuthor", fields: [authorId], references: [id])
  attachments Attachment[]

  @@index([requestId])
  @@map("request_updates")
}

/// An uploaded photo. The file lives outside the database under a random name; only a reference is stored.
model Attachment {
  id              String   @id @default(uuid()) @db.Uuid
  storedName      String   @unique
  originalName    String
  mimeType        String
  sizeBytes       Int
  uploadedById    String   @db.Uuid
  requestId       String?  @db.Uuid
  requestUpdateId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz

  uploadedBy    User                @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  request       MaintenanceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestUpdate RequestUpdate?      @relation(fields: [requestUpdateId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([requestUpdateId])
  @@map("attachments")
}
