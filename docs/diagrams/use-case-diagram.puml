@startuml use-case-diagram
title Apartment Management: use case diagram
' UML use case diagram for the Apartment Management system.
' Render: java -jar plantuml.jar -tpng use-case-diagram.puml
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam padding 4
skinparam nodesep 12
skinparam ranksep 90
skinparam defaultFontName Arial
skinparam actorStyle stick
skinparam usecase {
  BackgroundColor #EEF6F3
  BorderColor #1F6F5C
}
skinparam rectangle {
  BorderColor #555555
}

actor "User" as User
actor "Resident" as Resident
actor "Staff" as Staff
actor "Administrator" as Admin
Resident -up-|> User
Staff -up-|> User
Admin -up-|> User

rectangle "Apartment Management System" {
  usecase "UC-01 Log in" as UC01
  usecase "UC-02 Choose language" as UC02
  usecase "UC-03 Read announcements\nand notifications" as UC03
  usecase "UC-04 View bills and payments" as UC04
  usecase "Download receipt PDF" as UCR
  usecase "UC-05 Report a payment" as UC05
  usecase "UC-06 Submit a maintenance request" as UC06
  usecase "UC-07 Confirm or reopen a request" as UC07
  usecase "UC-08 Update an assigned request" as UC08
  usecase "UC-09 Manage residents and units" as UC09
  usecase "UC-10 Manage staff permissions" as UC10
  usecase "UC-11 Generate monthly bills" as UC11
  usecase "UC-12 Record or verify a payment" as UC12
  usecase "UC-13 Record an expense" as UC13
  usecase "UC-14 Prioritise and assign a request" as UC14
  usecase "UC-15 Publish an announcement" as UC15
  usecase "UC-16 View dashboard and reports" as UC16
}

User -- UC01
User -- UC02
User -- UC03

Resident -- UC04
Resident -- UC05
Resident -- UC06
Resident -- UC07
UCR .> UC04 : <<extend>>

Staff -- UC08

Admin -- UC09
Admin -- UC10
Admin -- UC11
Admin -- UC12
Admin -- UC13
Admin -- UC14
Admin -- UC15
Admin -- UC16

@enduml
