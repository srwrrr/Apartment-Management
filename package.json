{
  "name": "apartment-management",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web && npm run build -w server",
    "test": "npm run test -w packages/shared && npm run test -w server && npm run test -w web",
    "test:coverage": "npm run test -w packages/shared -- --coverage && npm run test -w server -- --coverage && npm run test -w web -- --coverage",
    "lint": "eslint packages/shared/src server/src server/prisma server/test web/src",
    "docs": "typedoc",
    "db:migrate": "npm run db:migrate -w server",
    "db:deploy": "npm run db:deploy -w server",
    "db:studio": "npm run db:studio -w server",
    "seed": "npm run seed -w server",
    "demo:reset": "npm run demo:reset -w server",
    "app": "npm run build -w web && npm run serve -w server",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test -c playwright.pwa.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "npm-run-all": "^4.1.5",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1"
  }
}
